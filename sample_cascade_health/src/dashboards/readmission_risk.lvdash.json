{
  "datasets": [
    {
      "displayName": "High-Risk Readmission Patients",
      "name": "high_risk_patients",
      "queryLines": [
        "WITH latest AS (\n",
        "  SELECT\n",
        "    MAX(discharge_date) AS max_date\n",
        "  FROM\n",
        "    cascade_health.cascade_gold.readmission_risk_scores\n",
        ")\n",
        "SELECT\n",
        "  s.patient_id,\n",
        "  p.first_name,\n",
        "  p.last_name,\n",
        "  d.age_at_admission,\n",
        "  d.primary_diagnosis,\n",
        "  d.discharge_date,\n",
        "  ROUND(s.risk_score, 2) AS risk_score,\n",
        "  s.top_3_reasons,\n",
        "  r.care_recommendation,\n",
        "  CEIL(COUNT(*) OVER () / 60.0) AS care_managers_needed\n",
        "FROM\n",
        "  cascade_health.cascade_gold.readmission_risk_scores s\n",
        "    JOIN cascade_health.cascade_gold.patient_discharges d\n",
        "      ON s.encounter_id = d.encounter_id\n",
        "    JOIN cascade_health.cascade_silver.patients p\n",
        "      ON s.patient_id = p.patient_id\n",
        "    LEFT JOIN cascade_health.cascade_gold.care_recommendations r\n",
        "      ON s.encounter_id = r.encounter_id\n",
        "    CROSS JOIN latest\n",
        "WHERE\n",
        "  s.risk_tier = 'High'\n",
        "  AND s.discharge_date > date_sub(latest.max_date, 7)\n",
        "ORDER BY\n",
        "  s.risk_score DESC"
      ]
    },
    {
      "config": {
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count",
            "expr": "COUNT(*)",
            "name": "count"
          }
        ],
        "source": "SELECT risk_tier,\r\n       COUNT(*) AS discharges,\r\n       ROUND(AVG(d.readmitted_30d) * 100, 0) AS pct_readmitted\r\nFROM cascade_health.cascade_gold.readmission_risk_scores s\r\nJOIN cascade_health.cascade_gold.patient_discharges d USING (encounter_id)\r\nGROUP BY risk_tier",
        "version": "1.1"
      },
      "displayName": "High Risk This Week",
      "name": "33a53544"
    }
  ],
